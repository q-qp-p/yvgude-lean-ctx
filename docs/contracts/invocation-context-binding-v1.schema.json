{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanctx.com/contracts/invocation-context-binding-v1.schema.json",
  "title": "LeanCTX InvocationContextBindingV1",
  "description": "Canonical signed, digest-only admission context for one Engine invocation.",
  "x-conformance": {
    "mode": "three_stage",
    "schema_validation_required": true,
    "semantic_validation_required": true,
    "cross_artifact_join_required": true,
    "semantic_validator": "lean_ctx_protocol::InvocationContextBindingV1::from_canonical_bytes",
    "signature_domain": "leanctx/invocation-context-binding/v1\\0",
    "stages": [
      {
        "name": "schema_validation",
        "required": true
      },
      {
        "name": "semantic_validation",
        "required": true
      },
      {
        "name": "cross_artifact_join",
        "required": true,
        "owner": "adapter_or_runtime_verifier",
        "protocol_decoder_sufficient": false,
        "requirements": [
          "resolve_and_verify_session_identity_bytes",
          "resolve_and_verify_task_bytes",
          "resolve_and_verify_plan_bytes",
          "resolve_and_verify_invocation_bytes",
          "resolve_and_verify_policy_bytes_from_policy_digest",
          "resolve_and_verify_source_artifact_bytes",
          "resolve_and_verify_capability_manifest_bytes",
          "verify_ed25519_signature_with_trusted_key",
          "apply_runtime_time_trust_and_consumption_gates"
        ]
      }
    ],
    "signature": {
      "algorithm": "ed25519",
      "decoded_bytes": 64,
      "canonical_base64_length": 88,
      "pad_bits_must_be_zero": true
    },
    "arrays": {
      "source_bindings_order": "source_ref_ascending",
      "capability_bindings_order": "capability_id_then_version_ascending"
    },
    "runtime_gates_not_in_decoder": [
      "trust_store_admission",
      "revocation",
      "one_time_consumption",
      "current_time_window"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_id",
    "session_identity_ref",
    "task_id",
    "task_ref",
    "plan_id",
    "plan_ref",
    "invocation_id",
    "invocation_ref",
    "policy_ref",
    "policy_digest",
    "decision",
    "source_bindings",
    "capability_bindings",
    "issued_at",
    "not_before",
    "expires_at",
    "signer",
    "signature"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "admission_id": { "$ref": "#/$defs/bounded" },
    "session_identity_ref": { "$ref": "#/$defs/digest" },
    "task_id": { "$ref": "#/$defs/bounded" },
    "task_ref": { "$ref": "#/$defs/digest" },
    "plan_id": { "$ref": "#/$defs/bounded" },
    "plan_ref": { "$ref": "#/$defs/digest" },
    "invocation_id": { "$ref": "#/$defs/bounded" },
    "invocation_ref": { "$ref": "#/$defs/digest" },
    "policy_ref": { "$ref": "#/$defs/reference" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "decision": { "const": "admitted" },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/sourceBinding" },
      "description": "Semantic validation requires exactly one input and source_ref ascending order."
    },
    "capability_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/capabilityBinding" },
      "description": "Semantic validation requires unique pairs/digests and capability_id/version ascending order."
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "signer": { "$ref": "#/$defs/signer" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=[\\s\\S]*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 256,
      "description": "Schema maxLength counts code points; semantic validation enforces the shared 256-byte UTF-8 bound."
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=[\\s\\S]*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 1024,
      "description": "Schema maxLength counts code points; semantic validation enforces the shared 1,024-byte UTF-8 bound."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "maxLength": 20
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "digest", "role"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["input", "context"] }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "manifest_digest"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/bounded" },
        "capability_version": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf8Bytes": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key_digest"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "description": "Semantic validation also rejects key material prefixes base64: and hex:."
        },
        "public_key_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "description": "Semantic validation also rejects non-zero Base64 pad bits."
    }
  }
}
