{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanctx.com/contracts/invocation-evidence-manifest-v1.schema.json",
  "title": "LeanCTX InvocationEvidenceManifestV1",
  "description": "Strict digest-only evidence join for one admitted Engine invocation.",
  "x-conformance": {
    "mode": "two_stage",
    "schema_validation_required": true,
    "semantic_validation_required": true,
    "semantic_validator": "lean_ctx_protocol::InvocationEvidenceManifestV1::from_canonical_bytes",
    "utf8_bounds": {
      "keyword": "x-maxUtf8Bytes",
      "unit": "utf8_bytes",
      "schema_enforcement": "annotation_only",
      "semantic_enforcement": "mandatory",
      "schema_alone_insufficient": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_ref",
    "engine_receipt",
    "source_bindings",
    "policy_bindings",
    "capability_bindings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "invocation_ref": { "$ref": "#/$defs/digest" },
    "engine_receipt": { "$ref": "#/$defs/engineReceipt" },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/sourceBinding" },
      "description": "Rust validation requires unique source_ref and digest values and exactly one input role."
    },
    "policy_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/policyBinding" },
      "description": "Rust validation requires exactly one invocation_admission and rejects duplicate optional roles; a later cross-artifact verifier compares present roles to TaskEnvelope/Plan/Invocation refs without fabricating bindings."
    },
    "capability_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/capabilityBinding" },
      "description": "Rust validation requires unique capability_id/version pairs and manifest digests."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 256,
      "description": "JSON Schema maxLength counts Unicode code points; an independent verifier MUST additionally enforce the shared 256-byte UTF-8 bound."
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=.*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 1024,
      "description": "JSON Schema maxLength counts Unicode code points; an independent verifier MUST additionally enforce the shared 1024-byte UTF-8 ProtocolReference bound."
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "x-maxUtf8Bytes": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "engineReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "receipt_digest"],
      "properties": {
        "receipt_ref": {
          "type": "string",
          "pattern": "^receipt:sha256:[0-9a-f]{64}$",
          "description": "Rust validation additionally requires exact equality with receipt:receipt_digest."
        },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "digest", "role"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["input", "context"] }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "digest", "role"],
      "properties": {
        "policy_ref": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/digest" },
        "role": {
          "enum": ["task_region", "task_model", "plan_decision", "invocation_admission"]
        }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "manifest_digest"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/bounded" },
        "capability_version": { "$ref": "#/$defs/semver" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
