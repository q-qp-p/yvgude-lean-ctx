{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanctx.com/contracts/invocation-evidence-manifest-v1.schema.json",
  "title": "LeanCTX InvocationEvidenceManifestV1",
  "description": "Strict digest-only evidence join for one admitted Engine invocation.",
  "x-conformance": {
    "mode": "three_stage",
    "schema_validation_required": true,
    "semantic_validation_required": true,
    "cross_artifact_join_required": true,
    "semantic_validator": "lean_ctx_protocol::InvocationEvidenceManifestV1::from_canonical_bytes",
    "stages": [
      {
        "name": "schema_validation",
        "required": true
      },
      {
        "name": "semantic_validation",
        "required": true
      },
      {
        "name": "cross_artifact_join",
        "required": true,
        "owner": "adapter_or_verifier",
        "protocol_decoder_sufficient": false,
        "requirements": [
          "policy_role_set_matches_refs_present_in_task_plan_invocation",
          "policy_aliases_repeat_only_exact_ref_and_digest_across_distinct_roles",
          "policy_conflicting_ref_digest_and_duplicate_role_bindings_rejected",
          "policy_duplicate_identical_bindings_rejected",
          "exact_proof_requires_signed_InvocationContextBindingV1_sidecar",
          "resolve_and_verify_invocation_artifact_bytes",
          "resolve_and_verify_source_artifact_bytes",
          "resolve_and_verify_policy_artifact_bytes",
          "invocation_admission_digest_resolves_signed_InvocationContextBindingV1_then_binding_policy_digest_resolves_signed_policy_bytes",
          "resolve_and_verify_capability_manifest_bytes",
          "resolve_and_verify_engine_receipt_bytes"
        ]
      }
    ],
    "utf8_bounds": {
      "keyword": "x-maxUtf8Bytes",
      "unit": "utf8_bytes",
      "schema_enforcement": "annotation_only",
      "semantic_enforcement": "mandatory",
      "schema_alone_insufficient": true
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_ref",
    "engine_receipt",
    "source_bindings",
    "policy_bindings",
    "capability_bindings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "invocation_ref": { "$ref": "#/$defs/digest" },
    "engine_receipt": { "$ref": "#/$defs/engineReceipt" },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/sourceBinding" },
      "description": "Rust validation requires unique source_ref and digest values and exactly one input role."
    },
    "policy_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/policyBinding" },
      "description": "Rust validation requires exactly one invocation_admission, permits one exact policy_ref+digest alias across distinct roles, and rejects conflicting aliases, duplicate roles, or duplicate identical bindings; a later verifier compares present roles to TaskEnvelope/Plan/Invocation refs without fabricating bindings. The invocation_admission digest resolves signed InvocationContextBindingV1 bytes, whose embedded policy_digest resolves the signed admission-policy bytes."
    },
    "capability_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/capabilityBinding" },
      "description": "Rust validation requires unique capability_id/version pairs and manifest digests."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=[\\s\\S]*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 256,
      "description": "JSON Schema maxLength counts Unicode code points; an independent verifier MUST additionally enforce the shared 256-byte UTF-8 bound."
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=[\\s\\S]*[^\\s])[^\\u0000-\\u001F\\u007F-\\u009F\\uFEFF]+$",
      "x-maxUtf8Bytes": 1024,
      "description": "JSON Schema maxLength counts Unicode code points; an independent verifier MUST additionally enforce the shared 1024-byte UTF-8 ProtocolReference bound."
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "x-maxUtf8Bytes": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "engineReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "receipt_digest"],
      "properties": {
        "receipt_ref": {
          "type": "string",
          "pattern": "^receipt:sha256:[0-9a-f]{64}$",
          "description": "Rust validation additionally requires exact equality with receipt:receipt_digest."
        },
        "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "digest", "role"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/digest" },
        "role": { "enum": ["input", "context"] }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "digest", "role"],
      "properties": {
        "policy_ref": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/digest" },
        "role": {
          "enum": ["task_region", "task_model", "plan_decision", "invocation_admission"]
        }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "manifest_digest"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/bounded" },
        "capability_version": { "$ref": "#/$defs/semver" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
