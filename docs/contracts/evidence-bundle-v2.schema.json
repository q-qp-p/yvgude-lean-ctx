{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanctx.dev/contracts/evidence-bundle-v2.schema.json",
  "title": "LeanCTX Customer-Proof Evidence Bundle v2",
  "description": "Strict additive contract for a bounded customer-proof observation; distinct from frozen audit evidence-bundle-v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_kind",
    "bundle_id",
    "bundle_digest",
    "created_at",
    "status",
    "subject",
    "matched_arms",
    "inventory",
    "quality",
    "replay",
    "limitations",
    "redaction",
    "claims",
    "signing"
  ],
  "properties": {
    "schema_version": {
      "const": "leanctx.customer-proof-evidence-bundle/v2"
    },
    "bundle_kind": {
      "const": "customer-proof"
    },
    "bundle_id": {
      "$ref": "#/$defs/contentId"
    },
    "bundle_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "invalid"]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "matched_arms": {
      "$ref": "#/$defs/matchedArms"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "replay": {
      "$ref": "#/$defs/replay"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "signing": {
      "$ref": "#/$defs/signing"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^id:sha256:[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^id:sha256:[0-9a-f]{64}$"
    },
    "signerRef": {
      "type": "string",
      "pattern": "^signer:id:sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "customerRef": {
      "type": "string",
      "pattern": "^customer:[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "projectRef": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "workloadRef": {
      "type": "string",
      "pattern": "^id:sha256:[0-9a-f]{64}$"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_ref", "project_ref", "workload_ref"],
      "properties": {
        "customer_ref": {
          "$ref": "#/$defs/customerRef"
        },
        "project_ref": {
          "$ref": "#/$defs/projectRef"
        },
        "workload_ref": {
          "$ref": "#/$defs/workloadRef"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "source_commit",
        "workload_digest"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "source_commit": {
          "$ref": "#/$defs/sourceCommit"
        },
        "workload_digest": {
          "$ref": "#/$defs/digest"
        },
        "endpoint_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/@-]{0,127}$"
        }
      }
    },
    "measurementStatus": {
      "type": "string",
      "enum": ["observed", "estimated", "unavailable", "not_applicable"]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_micros", "status"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "status": {
          "$ref": "#/$defs/measurementStatus"
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "latency_ms",
        "cost",
        "status"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "status": {
          "$ref": "#/$defs/measurementStatus"
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "arm_id",
        "identity",
        "status",
        "measurements",
        "evidence_refs"
      ],
      "properties": {
        "role": {
          "enum": ["control", "treatment"]
        },
        "arm_id": {
          "$ref": "#/$defs/contentId"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "measurements": {
          "$ref": "#/$defs/measurements"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "matchedArms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "match_basis",
        "shared_identity",
        "control",
        "treatment"
      ],
      "properties": {
        "match_id": {
          "$ref": "#/$defs/contentId"
        },
        "match_basis": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "provider",
              "model",
              "source_commit",
              "workload_digest"
            ]
          }
        },
        "shared_identity": {
          "$ref": "#/$defs/identity"
        },
        "control": {
          "$ref": "#/$defs/arm"
        },
        "treatment": {
          "$ref": "#/$defs/arm"
        }
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "path",
        "digest",
        "size_bytes",
        "availability",
        "redaction_class"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "kind": {
          "type": "string",
          "enum": [
            "arm_receipt",
            "receipt_predecessor",
            "quality_measurement",
            "replay_input",
            "replay_result",
            "run_metadata",
            "claim_basis",
            "frozen_audit_bundle_v1",
            "task_envelope",
            "execution_plan",
            "engine_invocation",
            "accepted_outcome",
            "measurement",
            "assumption",
            "formula",
            "price_table",
            "invoice",
            "acceptance_evidence"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "not": {
            "pattern": "(^|/)[.][.]?(/|$)"
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "availability": {
          "type": "string",
          "enum": ["present", "omitted", "unavailable"]
        },
        "redaction_class": {
          "$ref": "#/$defs/redactionClass"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "item_count", "total_bytes", "items"],
      "properties": {
        "max_items": {
          "const": 128
        },
        "item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "items": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inventoryItem"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metric",
        "control_score_milli",
        "treatment_score_milli",
        "confidence",
        "method",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["preserved", "degraded", "inconclusive", "not_measured"]
        },
        "metric": {
          "const": "score_milli"
        },
        "control_score_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "treatment_score_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unavailable"]
        },
        "method": {
          "type": "string",
          "enum": ["human", "automated", "mixed", "unavailable"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mode",
        "determinism",
        "input_refs",
        "result_refs",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "replayable",
            "partial",
            "not_replayable",
            "not_attempted"
          ]
        },
        "mode": {
          "type": "string",
          "enum": ["offline", "online", "mixed", "none"]
        },
        "determinism": {
          "type": "string",
          "enum": [
            "deterministic",
            "same_inputs_expected",
            "not_deterministic",
            "not_assessed"
          ]
        },
        "input_refs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "result_refs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "limitationCode": {
      "type": "string",
      "enum": [
        "omission_before_capture",
        "third_party_attestation",
        "generalization_beyond_workload",
        "production_sla",
        "future_outcomes",
        "unavailable_external_service",
        "redacted_content"
      ]
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_limitations", "unproven"],
      "properties": {
        "known_limitations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "unproven": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/limitationCode"
          }
        }
      }
    },
    "redactionClass": {
      "type": "string",
      "enum": [
        "none",
        "pseudonymized",
        "metadata_only",
        "content_removed",
        "secret_removed",
        "aggregated"
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "policy", "reversible", "notes"],
      "properties": {
        "class": {
          "$ref": "#/$defs/redactionClass"
        },
        "policy": {
          "type": "string",
          "enum": [
            "no_redaction",
            "customer_policy",
            "secret_scrub",
            "content_minimization"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "claim_validity",
        "scope",
        "basis_refs"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/contentId"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "cost_reduction",
            "token_reduction",
            "quality_preserved",
            "latency_change",
            "replayability",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "claim_validity": {
          "type": "string",
          "enum": ["supported", "inconclusive", "unsupported", "not_asserted"]
        },
        "scope": {
          "type": "string",
          "enum": ["matched_run", "customer_workload", "general"]
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "trusted_signer_ref",
        "key_id",
        "trust_basis",
        "signed_digest",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "trusted_signer_ref": {
          "$ref": "#/$defs/signerRef"
        },
        "key_id": {
          "$ref": "#/$defs/contentId"
        },
        "trust_basis": {
          "type": "string",
          "enum": [
            "customer_configured",
            "out_of_band",
            "local_identity"
          ]
        },
        "signed_digest": {
          "$ref": "#/$defs/digest"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
        }
      }
    }
  }
}
