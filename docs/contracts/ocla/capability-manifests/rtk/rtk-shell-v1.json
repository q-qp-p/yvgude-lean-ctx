{
  "schema_version": 1,
  "capability_id": "rtk-shell-output",
  "provider": "rtk-ai",
  "kind": "shell_output_optimization",
  "version": "1.0.0",
  "surfaces": ["shell"],
  "support_matrix": {
    "shell": {
      "supported": true,
      "input_schema_ref": "schema://rtk/ocla/shell-invocation/v1",
      "output_schema_ref": "schema://leanctx/ocla/context-observation/v1"
    }
  },
  "local": true,
  "remote": false,
  "reversibility": "reversible",
  "determinism": "non_deterministic",
  "data_movement": "none",
  "supported_classifications": ["Public", "Internal", "Confidential", "Restricted"],
  "measurement_support": {
    "latency": true,
    "tokens": true,
    "quality": true
  },
  "input_schema_ref": "schema://rtk/ocla/shell-invocation/v1",
  "output_schema_ref": "schema://leanctx/ocla/context-observation/v1",
  "conformance_version": 1,
  "failure_modes": ["timeout", "unavailable", "rejected_by_policy", "invalid_output", "fallback_to_native"],
  "observability": "capability_observation_v1",
  "execution": "local_only",
  "reversibility_scope": "full_original_preserved",
  "deterministic": false,
  "binary_name": "rtk",
  "binary_provenance": "user_installed",
  "version_policy": "manual_exact_pin",
  "hash_policy": "manual_sha256_pin",
  "update_policy": "manual_binary_pin_and_hash_verification",
  "failure_behavior": "timeout_or_health_failure_falls_back_to_native",
  "schemas": {
    "schema://rtk/ocla/shell-invocation/v1": {
      "type": "object",
      "required": ["command", "workdir"],
      "properties": {
        "command": {"type": "string"},
        "workdir": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "schema://leanctx/ocla/context-observation/v1": {
      "type": "object",
      "required": ["schema_version", "task_id", "capability_id", "capability_version", "success", "input_tokens", "output_tokens", "latency_ms", "failure_mode", "output_ref", "metrics"],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"type": "string"},
        "capability_id": {"type": "string"},
        "capability_version": {"type": "string"},
        "success": {"type": "boolean"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "failure_mode": {"type": ["string", "null"]},
        "output_ref": {"type": ["string", "null"]},
        "metrics": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
