{
  "schema_version": 1,
  "capability_id": "capability://leanctx/context-optimization",
  "provider": "leanctx",
  "kind": "context_source",
  "version": "1.0.0",
  "surfaces": ["context"],
  "support_matrix": {
    "context": {
      "supported": true,
      "input_schema_ref": "schema://leanctx/ocla/context-invocation/v1",
      "output_schema_ref": "schema://leanctx/ocla/context-observation/v1"
    }
  },
  "local": true,
  "remote": false,
  "reversibility": "reversible",
  "determinism": "deterministic",
  "data_movement": "local_only",
  "supported_classifications": ["Public", "Internal", "Confidential", "Restricted"],
  "measurement_support": {
    "latency": true,
    "tokens": true,
    "quality": true
  },
  "input_schema_ref": "schema://leanctx/ocla/context-invocation/v1",
  "output_schema_ref": "schema://leanctx/ocla/context-observation/v1",
  "conformance_version": 1,
  "failure_modes": ["timeout", "unavailable", "rejected_by_policy", "invalid_output"],
  "observability": "capability_observation_v1",
  "schemas": {
    "schema://leanctx/ocla/context-invocation/v1": {
      "type": "object",
      "required": ["paths", "mode", "budget_tokens"],
      "properties": {
        "paths": {"type": "array", "items": {"type": "string"}},
        "mode": {"type": "string"},
        "budget_tokens": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    },
    "schema://leanctx/ocla/context-observation/v1": {
      "type": "object",
      "required": ["schema_version", "task_id", "capability_id", "capability_version", "success", "input_tokens", "output_tokens", "latency_ms", "failure_mode", "output_ref", "metrics"],
      "properties": {
        "schema_version": {"const": 1},
        "task_id": {"type": "string"},
        "capability_id": {"type": "string"},
        "capability_version": {"type": "string"},
        "success": {"type": "boolean"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0},
        "failure_mode": {"type": ["string", "null"]},
        "output_ref": {"type": ["string", "null"]},
        "metrics": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
