{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanctx.com/contracts/receipt-document-v1.schema.json",
  "title": "LeanCTX ReceiptDocumentV1",
  "description": "Canonical signed local evidence receipt. Payloads stay outside the document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "lineage",
    "chain",
    "status",
    "values",
    "outcome",
    "evidence_refs",
    "issued_at",
    "signer",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/digest" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "chain": { "$ref": "#/$defs/chain" },
    "status": {
      "enum": ["succeeded", "failed", "rejected", "cancelled", "timed_out"]
    },
    "values": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/value" }
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "signer": { "$ref": "#/$defs/signer" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": {
        "properties": {
          "outcome": { "properties": { "state": { "const": "rejected" } } }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "properties": { "state": { "const": "rejected" } } } } },
      "then": { "properties": { "status": { "const": "rejected" } } }
    },
    {
      "if": { "properties": { "outcome": { "properties": { "state": { "const": "accepted" } } } } },
      "then": { "properties": { "status": { "const": "succeeded" } } }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "description": "SemVer 2.0.0 in ASCII; Rust runtime also enforces the 128-byte bound.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "timestamp": {
      "type": "string",
      "description": "Canonical UTC seconds; Rust runtime additionally rejects year 0000, impossible month/day combinations and non-leap February 29.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "mediaType": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9!#$&^_.+\\-]+/[A-Za-z0-9!#$&^_.+\\-]+$"
    },
    "evidenceUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "ASCII privacy-safe locator; Rust runtime additionally rejects path traversal (`..`).",
      "pattern": "^(?:artifact|evidence|bundle|source)://(?!/)(?!.*[?#@])[\\x21-\\x7E]+$|^urn:(?!.*[?#@])[\\x21-\\x7E]+$"
    },
    "signature": {
      "type": "string",
      "description": "Exactly 64 Ed25519 bytes in canonical RFC 4648 base64; final sextet pad bits are zero.",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_ref",
        "plan_id",
        "plan_ref",
        "invocation_id",
        "invocation_ref",
        "identity_ref",
        "policy_refs",
        "capabilities"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/bounded" },
        "task_ref": { "$ref": "#/$defs/digest" },
        "plan_id": { "$ref": "#/$defs/bounded" },
        "plan_ref": { "$ref": "#/$defs/digest" },
        "invocation_id": { "$ref": "#/$defs/bounded" },
        "invocation_ref": { "$ref": "#/$defs/digest" },
        "identity_ref": { "$ref": "#/$defs/digest" },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "description": "Rust runtime requires unique capability_id/version pairs and invocation_ref equal to lineage.invocation_ref.",
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version", "invocation_ref"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/bounded" },
        "capability_version": { "$ref": "#/$defs/semver" },
        "invocation_ref": { "$ref": "#/$defs/digest" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "sequence_number"],
      "properties": {
        "chain_id": { "$ref": "#/$defs/bounded" },
        "sequence_number": { "$ref": "#/$defs/safeInteger", "minimum": 1 },
        "previous_receipt_id": { "$ref": "#/$defs/digest" },
        "previous_signature_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "sequence_number": { "const": 1 } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["previous_receipt_id"] },
                { "required": ["previous_signature_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "sequence_number": { "minimum": 2 } } },
          "then": { "required": ["previous_receipt_id", "previous_signature_digest"] }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "Digest uniqueness by value is enforced by ReceiptDocumentV1 runtime validation; JSON Schema uniqueItems only catches identical objects.",
      "required": ["kind", "uri", "digest", "media_type", "signature_status"],
      "properties": {
        "kind": {
          "enum": ["measurement", "assumption", "formula", "price_table", "invoice", "outcome", "runtime", "methodology"]
        },
        "uri": { "$ref": "#/$defs/evidenceUri" },
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "$ref": "#/$defs/mediaType" },
        "signature_status": { "enum": ["Verified", "Unverified", "NotSigned"] }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rust runtime enforces digest uniqueness by value, typed evidence kinds, and exact-once formula/price/reconciliation references across direct and derived fields.",
      "required": ["name", "unit", "classification"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "unit": { "$ref": "#/$defs/name" },
        "classification": {
          "enum": ["measured", "estimated", "calculated", "reconciled", "unavailable"]
        },
        "value": { "$ref": "#/$defs/safeInteger" },
        "evidence_digests": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "formula_digest": { "$ref": "#/$defs/digest" },
        "price_table_digest": { "$ref": "#/$defs/digest" },
        "reconciliation_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "unavailable" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["value"] },
                { "required": ["evidence_digests"] },
                { "required": ["formula_digest"] },
                { "required": ["price_table_digest"] },
                { "required": ["reconciliation_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "classification": { "enum": ["measured", "estimated"] } } },
          "then": {
            "required": ["value", "evidence_digests"],
            "properties": { "evidence_digests": { "minItems": 1 } },
            "not": {
              "anyOf": [
                { "required": ["formula_digest"] },
                { "required": ["price_table_digest"] },
                { "required": ["reconciliation_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "classification": { "const": "calculated" } } },
          "then": {
            "required": ["value", "evidence_digests", "formula_digest", "price_table_digest"],
            "not": { "required": ["reconciliation_digest"] }
          }
        },
        {
          "if": { "properties": { "classification": { "const": "reconciled" } } },
          "then": {
            "required": ["value", "evidence_digests", "formula_digest", "price_table_digest", "reconciliation_digest"]
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["accepted", "rejected", "unknown"] },
        "outcome_id": { "$ref": "#/$defs/bounded" },
        "outcome_ref": { "$ref": "#/$defs/digest" },
        "acceptance_evidence_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "unknown" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["outcome_id"] },
                { "required": ["outcome_ref"] },
                { "required": ["acceptance_evidence_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "rejected" } } },
          "then": {
            "required": ["outcome_id", "outcome_ref"],
            "not": { "required": ["acceptance_evidence_digest"] }
          }
        },
        {
          "if": { "properties": { "state": { "const": "accepted" } } },
          "then": { "required": ["outcome_id", "outcome_ref", "acceptance_evidence_digest"] }
        }
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "key_admission"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "not": { "pattern": "^(?:base64|hex):" },
          "description": "External key identifier only; embedded base64/hex key material is rejected."
        },
        "key_admission": { "const": "external_trust_store" }
      }
    }
  }
}
